# ─────────────────────────────────────────────────
# Argus Backend 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채워서 사용하세요.
# (.env 는 .gitignore 에 포함되어 있으므로 커밋되지 않습니다)
# ─────────────────────────────────────────────────

# ── ZAP DAST ───────────────────────────────────
# ZAP 포트를 기본값 8080 에서 8090 으로 변경한 상태:
#   [ZAP GUI] Tools > Options > API > Port 를 8090 으로 변경 후 ZAP 재시작 필수
# ZAP_API_KEY 는 ZAP GUI Tools > Options > API > API Key 에서 확인
ZAP_API_URL=http://127.0.0.1:8090
ZAP_API_KEY=

# ── Database ───────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/argus

# ── Redis (Celery broker) ──────────────────────
# 기본 Redis 포트는 6379. 아래 예시는 로컬 6360 포트 사용
REDIS_URL=redis://localhost:6360/0

# ── AI API ────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Ollama 로컬 LLM (API 비용 없이 로컬 테스트 시 사용) ──────────
# 설치: https://ollama.com/download/windows
# 모델: ollama pull qwen2.5:7b   (RAM 16GB 이상 권장, 약 4.7GB)
# ANTHROPIC_API_KEY 미설정 시 자동으로 Ollama 사용
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── 스캔 결과 저장 경로 ─────────────────────────
# 상대경로면 프로젝트 루트 기준, 절대경로도 가능
SCAN_RESULTS_DIR=results
